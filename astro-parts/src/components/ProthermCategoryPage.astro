---
import type { ImageMetadata } from "astro";
import { sparePartsBrands } from "../../../app/data/spareParts";

interface Props {
  category: "Вентиляторы" | "Теплообменники";
  brandSlug?: "protherm" | "vaillant" | "baxi" | "viessmann" | "ariston" | "ferroli" | "fondital";
  brandName?: string;
  title: string;
  description: string;
  intro: string;
  selectionTitle: string;
  selectionText: string;
  faq: Array<{ question: string; answer: string }>;
}

const { category, brandSlug = "protherm", brandName = "Protherm", title, description, intro, selectionTitle, selectionText, faq } = Astro.props;
const phone = "8 (962) 352-70-02";
const phoneHref = "tel:+79623527002";
const slug = category === "Вентиляторы" ? "ventilyatory" : "teploobmenniki";
const canonical = `https://remontkotlov48.ru/zapchasti/${brandSlug}/${slug}/`;
const brand = sparePartsBrands.find((item) => item.slug === brandSlug);
if (!brand) throw new Error(`Не найден каталог ${brandName}`);
const parts = brand.parts.filter((part) => part.category === category && part.slug);
const isDhwHeatExchanger = (name: string) => /\bгвс\b|вторичн/i.test(name);
const primaryHeatParts = parts.filter((part) => !isDhwHeatExchanger(part.name));
const dhwHeatParts = parts.filter((part) => isDhwHeatExchanger(part.name));
const assets = import.meta.glob<{ default: ImageMetadata }>("../assets/spare-parts/optimized/*.{webp,png}", { eager: true });
const imageByFile = new Map(Object.entries(assets).map(([path, image]) => [path.split("/").at(-1)!, image.default]));
const imageFilesBySlug = new Map<string, string>([
