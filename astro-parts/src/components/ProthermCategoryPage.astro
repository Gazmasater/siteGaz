]);
const imageFileFor = (partSlug?: string) => imageFilesBySlug.get(partSlug ?? "") ?? (partSlug?.startsWith("baxi-heat-") ? `${partSlug}.webp` : undefined);
const imageFor = (partSlug?: string) => {
  const image = imageByFile.get(imageFileFor(partSlug) ?? "");
  if (!image) throw new Error(`Не найдено изображение для ${partSlug}`);
  return image;
};
const imageSrcFor = (part: (typeof parts)[number]) => {
  if (brandSlug === "ferroli" || brandSlug === "fondital") return part.image;
  const file = imageFileFor(part.slug);
  if (!file) throw new Error(`Не найдено изображение для ${part.slug}`);
  return file.startsWith("vaillant-") || file.startsWith("viessmann-") || file.startsWith("ariston-") || file.startsWith("navien-") ? `/img/spare-parts/${file}` : imageFor(part.slug).src;
};
const ogImage = "https://remontkotlov48.ru/img/header-boiler-generated-79330917276.webp";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "CollectionPage", name: title, description, url: canonical, inLanguage: "ru-RU" },
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Главная", item: "https://remontkotlov48.ru/" },
      { "@type": "ListItem", position: 2, name: "Запчасти", item: "https://remontkotlov48.ru/zapchasti/" },
      { "@type": "ListItem", position: 3, name: `${brandName} — ${category}`, item: canonical },
    ] },
    { "@type": "ItemList", name: title, numberOfItems: parts.length, itemListElement: parts.map((part, index) => ({ "@type": "ListItem", position: index + 1, name: part.name, url: `https://remontkotlov48.ru/zapchasti/${brandSlug}/${part.slug}/` })) },
    { "@type": "FAQPage", mainEntity: faq.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) },
  ],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={`${title} | Gazmaster`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="604" />
    <meta property="og:image:alt" content={`${title} — Gazmaster`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" href={canonical} hreflang="ru-RU" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title} | Gazmaster</title>
  </head>
  <body>
    <header class="site-header"><div class="header-inner"><a class="brand" href="/" aria-label="Gazmaster — главная"><b class="brand-logo"><img src="/img/gazmaster-watermark.webp" alt="" /></b><span><strong>Gazmaster</strong><small>Ремонт котлов · Липецк</small></span></a><nav aria-label="Основная навигация"><a href="/lipeck/uslugi/remont-gazovyh-kotlov/">Ремонт котлов</a><a class="active" href="/zapchasti/">Запчасти</a></nav><a class="call-button" href={phoneHref}>Вызвать мастера</a></div></header>
    <main class="container">
      <nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/">Главная</a><span>/</span><a href="/zapchasti/">Запчасти</a><span>/</span><a href={`/zapchasti/?brand=${brandSlug}`}>{brandName}</a><span>/</span><b>{category}</b></nav>
      <section class="hero"><p>Запчасти {brandName} · Липецк</p><h1>{title}</h1><span>{intro}</span><div><a class="primary" href={phoneHref}>Подобрать запчасть</a><a class="secondary" href={`/zapchasti/?brand=${brandSlug}`}>Все запчасти {brandName}</a></div></section>
      <section aria-labelledby="products-title">
        <div class="section-title"><div><p>В наличии под заказ</p><h2 id="products-title">{parts.length} позиций в каталоге</h2></div><span>Проверка по модели и серийному номеру</span></div>
        {category === "Теплообменники" ? <>
          <section id="osnovnye" class="product-group" aria-labelledby="primary-heat-title">
            <h3 id="primary-heat-title">Основные и битермические теплообменники</h3>
            <div class="product-grid">{primaryHeatParts.map((part, index) => <article class="product-card"><a href={`/zapchasti/${brandSlug}/${part.slug}/`}><div class="product-photo"><img src={imageSrcFor(part)} alt={part.name} loading={index < 2 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} /></div><div class="product-info"><p>{part.category}</p><h3>{part.name}</h3><span>Арт. {part.article}</span><b>Открыть карточку →</b></div></a></article>)}</div>
          </section>
          <section id="gvs" class="product-group" aria-labelledby="dhw-heat-title">
            <h3 id="dhw-heat-title">Теплообменники ГВС</h3>
            <div class="product-grid">{dhwHeatParts.map((part) => <article class="product-card"><a href={`/zapchasti/${brandSlug}/${part.slug}/`}><div class="product-photo"><img src={imageSrcFor(part)} alt={part.name} loading="lazy" fetchpriority="auto" /></div><div class="product-info"><p>{part.category}</p><h3>{part.name}</h3><span>Арт. {part.article}</span><b>Открыть карточку →</b></div></a></article>)}</div>
          </section>
        </> : <div class="product-grid">{parts.map((part, index) => <article class="product-card"><a href={`/zapchasti/${brandSlug}/${part.slug}/`}><div class="product-photo"><img src={imageSrcFor(part)} alt={part.name} loading={index < 2 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} /></div><div class="product-info"><p>{part.category}</p><h3>{part.name}</h3><span>Арт. {part.article}</span><b>Открыть карточку →</b></div></a></article>)}</div>}
      </section>
      <section class="selection"><h2>{selectionTitle}</h2><p>{selectionText}</p><p>Перед заказом пришлите фото шильдика котла или назовите модель и серийный номер. Это исключает ошибку при выборе и помогает сразу предложить совместимый вариант.</p></section>
      <section class="faq" aria-labelledby="faq-title"><h2 id="faq-title">Вопросы по подбору</h2>{faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
      <p class="back"><a href={`/zapchasti/?brand=${brandSlug}`}>← Все запчасти {brandName}</a></p>
    </main>
    <footer><div><strong>Gazmaster</strong><span>Ремонт, диагностика и подбор запчастей для котлов в Липецке.</span></div><a href={phoneHref}>{phone}</a></footer>
  </body>
</html>

<style>
  :root { color:#172033; font-family:Arial,sans-serif; background:#f5f7fb; } * { box-sizing:border-box; } body { margin:0; }.site-header { border-bottom:1px solid #e4e8ee; background:#fff; }.header-inner,.container { width:min(1180px,calc(100% - 40px)); margin:0 auto; }.header-inner { display:flex; align-items:center; min-height:76px; gap:25px; }.brand { display:flex; align-items:center; gap:10px; color:#172033; text-decoration:none; }.brand>b { display:grid; place-items:center; width:37px; height:37px; border-radius:12px; color:#172033; background:#f2c94c; font-size:20px; }.brand strong,.brand small { display:block; }.brand strong { font-size:16px; }.brand small { margin-top:3px; color:#7c8796; font-size:10px; }.header-inner nav { display:flex; gap:19px; margin-left:auto; }.header-inner nav a { color:#5b687a; font-size:13px; font-weight:700; text-decoration:none; }.header-inner nav .active { color:#946011; }.call-button,.primary { padding:11px 14px; border-radius:9px; color:#fff; background:#1c2737; font-size:12px; font-weight:800; text-decoration:none; white-space:nowrap; }.container { padding:34px 0 80px; }.breadcrumbs { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:32px; color:#8390a4; font-size:13px; }.breadcrumbs a { color:#526780; text-decoration:none; }.breadcrumbs b { color:#38465c; }.hero { max-width:840px; margin-bottom:40px; }.hero>p,.section-title p { margin:0 0 10px; color:#bd811a; font-size:11px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }.hero h1 { max-width:760px; margin:0 0 16px; font-size:clamp(36px,5vw,58px); letter-spacing:-.055em; line-height:1.05; }.hero>span { display:block; color:#617086; font-size:16px; line-height:1.65; }.hero>div { display:flex; flex-wrap:wrap; gap:10px; margin-top:24px; }.primary { padding:14px 18px; }.secondary { padding:13px 17px; border:1px solid #e4cf9d; border-radius:9px; color:#795510; background:#fff8e8; font-size:13px; font-weight:800; text-decoration:none; }.section-title { display:f