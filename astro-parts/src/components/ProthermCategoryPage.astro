  ["fime-vgr0042710-5653850", "baxi-fan-1.webp"], ["fime-vgr0013184-5682150", "baxi-fan-2.webp"], ["sohon-nuvola-5632530", "baxi-fan-3.webp"], ["eco-classic-eco-nova-63111300821p", "baxi-fan-4.webp"], ["fime-vgr0012650-710365100", "baxi-fan-5.webp"], ["fime-vgr0042711-5655730", "baxi-fan-6.webp"], ["eco-life-eco-star-7731816", "baxi-fan-7.webp"], ["baxi-5653850", "baxi-fan-8-clean.webp"], ["ebm-5682150", "baxi-fan-9.webp"], ["baxi-5655730", "baxi-fan-10.webp"], ["baxi-5691840", "baxi-fan-11-clean.webp"], ["nuvola-3-comfort-320-5695650", "baxi-fan-12.webp"], ["baxi-nuvola-5632530", "baxi-fan-13-clean.webp"], ["baxi-5663810", "baxi-fan-14-clean.webp"], ["baxi-768062100", "baxi-fan-15.webp"], ["luna-duo-tec-mp-710754100", "baxi-fan-16.webp"], ["luna-ht-power-ht-3621190", "baxi-fan-17.webp"], ["luna-ht-5681550", "baxi-fan-18-clean.webp"],
