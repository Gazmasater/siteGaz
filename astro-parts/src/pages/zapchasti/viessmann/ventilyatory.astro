---
import ProthermCategoryPage from "../../../components/ProthermCategoryPage.astro";

const faq = [
  { question: "Как подобрать вентилятор Viessmann?", answer: "Сообщите модель котла, артикул старого вентилятора и серийный номер. Внешне похожие детали могут отличаться мощностью, разъёмом и креплением." },
  { question: "Для каких котлов Viessmann есть вентиляторы?", answer: "В каталоге представлены вентиляторы для серий Vitopend 100-W и Vitopend 222-W. Совместимость перед заказом обязательно проверяем." },
  { question: "Можно ли заказать по артикулу?", answer: "Да. Укажите артикул детали и модель котла — уточним наличие, цену и срок поставки." },
];
---

<ProthermCategoryPage
  category="Вентиляторы"
  brandSlug="viessmann"
  brandName="Viessmann"
  title="Вентиляторы для котлов Viessmann в Липецке"
  description="Вентиляторы для газовых котлов Viessmann Vitopend 100-W и Vitopend 222-W. Подбор по модели и артикулу в Липецке."
  intro="Каталог вентиляторов для газовых котлов Viessmann. Подберём деталь по артикулу, модели и серийному номеру: это важно для совпадения мощности, разъёма и крепления."
  selectionTitle="Как подобрать вентилятор Viessmann"
  selectionText="Укажите модель котла, артикул старого вентилятора или отправьте фото шильдика. Мы сверим совместимость до заказа и сообщим наличие."
  faq={faq}
/>
