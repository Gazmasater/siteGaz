---
import ProthermCategoryPage from "../../../components/ProthermCategoryPage.astro";

const faq = [
  { question: "Как подобрать теплообменник Viessmann?", answer: "Сообщите модель котла, артикул прежней детали и серийный номер. Для пластинчатых теплообменников важны число пластин, присоединения и мощность котла." },
  { question: "Есть ли в каталоге первичные и вторичные теплообменники?", answer: "Да. В разделе представлены основные теплообменники и пластинчатые теплообменники ГВС для распространённых моделей Viessmann." },
  { question: "Можно ли заказать по артикулу?", answer: "Да. Укажите артикул и модель котла — проверим совместимость, наличие, цену и срок поставки." },
];
---

<ProthermCategoryPage
  category="Теплообменники"
  brandSlug="viessmann"
  brandName="Viessmann"
  title="Теплообменники для котлов Viessmann в Липецке"
  description="Основные и пластинчатые теплообменники для котлов Viessmann Vitopend и Vitodens. Подбор по модели, артикулу и серийному номеру в Липецке."
  intro="Каталог теплообменников для газовых котлов Viessmann: пластинчатые ГВС и основные. Перед заказом сверим артикул, мощность, модель и серийный номер котла."
  selectionTitle="Как подобрать теплообменник Viessmann"
  selectionText="Сообщите артикул старой детали, модель и мощность котла или отправьте фото шильдика. Проверим совместимость до заказа и сообщим наличие."
  faq={faq}
/>
