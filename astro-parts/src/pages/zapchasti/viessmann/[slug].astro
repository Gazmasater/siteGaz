  ["heat-14-zilmet-a1jb-7856964", ["Vitopend 100-W A1JB 29,9 кВт", "Vitopend 100-W WH1B 30 кВт"]],
  ["heat-14-zilmet-wh1d-7829304", ["Vitopend 100-W WH1D 30 кВт"]],
