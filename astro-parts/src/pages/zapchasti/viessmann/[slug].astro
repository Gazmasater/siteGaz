export const getStaticPaths = (() => {
  const brand = sparePartsBrands.find((item) => item.slug === "viessmann")!;
  return brand.parts.map((part) => ({ params: { slug: part.slug! }, props: { part } }));
}) satisfies GetStaticPaths;

const { part } = Astro.props as { part: SparePart };
const telegramRequestUrl = `/zapchasti/request/?start=request-viessmann-${sparePartsBrands.find((item) => item.slug === "viessmann")!.parts.indexOf(part).toString(36)}`;
const imageFile = imageFilesBySlug.get(part.slug ?? "");
if (!imageFile) throw new Error(`Не найдено изображение товара ${part.slug}`);
const measurementImageFile = measurementImageFilesBySlug.get(part.slug ?? "");
const compatibleModels = compatibleModelsBySlug.get(part.slug ?? "") ?? ["Подбор по артикулу, модели и серийному номеру котла"];
const seo = buildProductSeo(part, "Viessmann", compatibleModels);
const title = buildProductTitle(part);
const canonical = `https://remontkotlov48.ru/zapchasti/viessmann/${part.slug}/`;
const ogImage = `https://remontkotlov48.ru/img/spare-parts/${imageFile}`;
const categorySlug = part.category === "Теплообменники" ? "teploobmenniki" : "ventilyatory";
const categoryUrl = `/zapchasti/viessmann/${categorySlug}/`;
const seoModels = compatibleModels.slice(0, 3);
const structuredData = { "@context": "https://schema.org", "@graph": [
  { "@type": "Product", name: part.name, description: seo.lead, sku: part.article, category: part.category, brand: { "@type": "Brand", name: "Viessmann" }, url: canonical, additionalProperty: compatibleModels.map((model) => ({ "@type": "PropertyValue", name: "Совместимая модель котла", value: model })) },
  { "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: "https://remontkotlov48.ru/" },
    { "@type": "ListItem", position: 2, name: "Запчасти", item: "https://remontkotlov48.ru/zapchasti/" },
    { "@type": "ListItem", position: 3, name: `Viessmann · ${part.category}`, item: `https://remontkotlov48.ru${categoryUrl}` },
    { "@type": "ListItem", position: 4, name: part.name, item: canonical },
  ] },
] };
---

<!doctype html>
<html lang="ru"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={seo.metaDescription} /><meta name="robots" content="index, follow, max-image-preview:large" /><meta property="og:type" content="product" /><meta property="og:locale" content="ru_RU" /><meta property="og:title" content={title} /><meta property="og:description" content={seo.metaDescription} /><meta property="og:url" content={canonical} /><meta property="og:image" content={ogImage} /><meta property="og:image:alt" content={part.name} /><link rel="canonical" href={canonical} /><link rel="alternate" href={canonical} hreflang="ru-RU" /><script type="application/ld+json" set:html={JSON.stringify(structuredData)} /><title>{title}</title></head>
<body><header><a class="brand" href="/"><b><img src="/img/gazmaster-watermark.webp" alt="" /></b><span><strong>Gazmaster</strong><small>Ремонт котлов · Липецк</small></span></a><nav><a href="/lipeck/uslugi/remont-gazovyh-kotlov/">Ремонт котлов</a><a href="/zapchasti/">Запчасти</a></nav><a class="call" href={phoneHref}>Вызвать мастера</a></header><main><nav class="breadcrumbs"><a href="/">Главная</a><span>/</span><a href="/zapchasti/">Запчасти</a><span>/</span><a href={categoryUrl}>Viessmann · {part.category}</a><span>/</span><b>{part.name}</b></nav><article class="product"><div class="gallery"><div class="photo"><img data-main-image src={`/img/spare-parts/${imageFile}`} alt={part.name} width="800" height="600" loading="eager" fetchpriority="high" /></div>{measurementImageFile && <div class="thumbnails"><button class="thumbnail active" type="button" data-gallery-image={`/img/spare-parts/${imageFile}`} aria-label="Основной ракурс"><img src={`/img/spare-parts/${imageFile}`} alt="Основной ракурс" /></button><button class="thumbnail dimensions" type="button" data-gallery-image={`/img/spare-parts/${measurementImageFile}`} aria-label="Размеры"><img src={`/img/spare-parts/${measurementImageFile}`} alt={`${part.name} — размеры`} /><span>Размеры</span></button></div>}</div><div class="details"><p class="eyebrow">Запчасти Viessmann · {part.category}</p><h1>{part.name}</h1><p class="article">Артикул: <b>{part.article}</b></p><p class="lead">{seo.lead}</p><div class="availability"><b>Наличие и цена — по запросу</b><span>Срок поставки — до 7 дней после подтверждения артикула.</span><span>Гарантия — 12 месяцев при правильной эксплуатации котла.</span></div><a class="buy" href={telegramRequestUrl}>Уточнить наличие</a></div></article><section class="info"><h2>Совместимые модели котлов</h2><ul>{compatibleModels.map((model) => <li>{model}</li>)}</ul><p>Перед заказом обязательно сверяем модель, серийный номер и комплектацию котла.</p><h2>Особенности подбора</h2><p>{seo.details}</p><h2>Как заказать</h2><p>Позвоните нам или отправьте фото шильдика: подтвердим совместимость, цену и наличие; срок поставки — до 7 дней.</p></section><p class="back"><a href={categoryUrl}>← Все {part.category.toLowerCase()} Viessmann</a></p></main><footer><div><strong>Gazmaster</strong><span>Ремонт, диагностика и подбор запчастей для котлов в Липецке.</span></div><a href={phoneHref}>{phone}</a></footer><script>document.querySelectorAll('.thumbnail[data-gallery-image]').forEach((thumb) => thumb.addEventListener('click', () => { const main = document.querySelector('[data-main-image]'); if (main instanceof HTMLImageElement) main.src = thumb.dataset.galleryImage ?? main.src; document.querySelectorAll('.thumbnail').forEach((item) => item.classList.toggle('active', item === thumb)); }));</script></body></html>

<style>
  :root{color:#172033;font-family:Arial,sans-serif;background:#f5f7fb}*{box-sizing:border-box}body{margin:0}header,main{width:min(1180px,calc(100% - 40px));margin:auto}header{display:flex;align-items:center;gap:25px;min-height:76px}.brand{display:flex;align-items:center;gap:10px;color:#172033;text-decoration:none}.brand>b{display:grid;place-items:center;width:52px;height:42px}.brand img{display:block;width:100%;height:100%;object-fit:contain}.brand strong,.brand small{display:block}.brand strong{font-size:16px}.brand small{margin-top:3px;color:#7c8796;font-size:10px}header nav{display:flex;gap:19px;margin-left:auto}header nav a{color:#5b687a;font-size:13px;font-weight:700;text-decoration:none}.call,.buy{padding:12px 15px;border-radius:9px;color:#fff;background:#1c2737;font-size:13px;font-weight:800;text-decoration:none}.breadcrumbs{display:flex;flex-wrap:wrap;gap:8px;margin:32px 0 30px;color:#8390a4;font-size:13px}.breadcrumbs a,.back a{color:#526780;text-decoration:none}.product{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.88fr);gap:54px;padding:26px;border:1px solid #e2e7ee;border-radius:20px;background:#fff;box-shadow:0 12px 30px rgba(30,41,59,.05)}.photo{position:relative;overflow:hidden;border-radius:14px;background:#fff;aspect-ratio:4/3}.photo::after{position:absolute;inset:0;pointer-events:none;background:url('/img/gazmaster-watermark.webp') 10px 10px/30% auto no-repeat;content:"";opacity:.12}.photo img{display:block;width:100%;height:100%;object-fit:cover}.thumbnails{display:flex;gap:10px;margin-top:10px}.thumbnail{position:relative;display:block;overflow:hidden;width:94px;padding:0;border:2px solid transparent;border-radius:9px;background:#fff;aspect-ratio:4/3;cursor:pointer}.thumbnail.active{border-color:#b77710}.thumbnail::after{position:absolute;inset:0;pointer-events:none;background:url('/img/gazmaster-watermark.webp') 3px 3px/30% auto no-repeat;content:"";opacity:.16}.thumbnail img{display:block;width:100%;height:100%;object-fit:cover}.thumbnail span{position:absolute;z-index:2;right:3px;bottom:3px;padding:2px 4px;border-radius:3px;color:#fff;background:rgba(23,32,51,.76);font-size:10px;font-weight:800}.eyebrow{margin:3px 0 11px;color:#b77710;font-size:11px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.details h1{margin:0 0 15px;font-size:clamp(32px,4vw,49px);letter-spacing:-.05em;line-height:1.07}.article{color:#66768a}.lead,.info p{color:#5e6d80;font-size:15px;line-height:1.7}.availability{display:flex;flex-direction:column;gap:5px;margin:20px 0 15px;padding:14px 16px;border-radius:12px;background:#fff7e2;color:#7e5a19}.availability b,.availability span{font-size:13px}.buy{display:block;text-align:center}.info{max-width:760px;margin:38px 0}.info h2{margin:25px 0 10px;font-size:24px}.info ul{display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0;list-style:none}.info li{padding:8px 10px;border:1px solid #e4cf9d;border-radius:8px;color:#705219;background:#fff8e8;font-size:13px;font-weight:700}.back{margin:31px 0}.back a{font-weight:700}footer{display:flex;justify-content:space-between;gap:24px;padding:35px max(20px,calc((100% - 1180px)/2));color:#d6dce4;background:#111827}footer strong,footer span{display:block}footer strong{margin-bottom:5px;color:#fff;font-size:18px}footer span{font-size:12px}footer>a{color:#f6ca58;font-size:17px;font-weight:800;text-decoration:none}@media(max-width:760px){header,main{width:min(100% - 32px,1180px)}header{min-height:68px}header nav{display:none}.call{margin-left:auto}.product{grid-template-columns:1fr;gap:25px;padding:15px}.breadcrumbs{margin:25px 0 22px}.details h1{font-size:34px}footer{align-items:flex-start;flex-direction:column}}
</style>
