const measurementImageFiles = new Set([
  "vaillant-heat-measure-11-2.webp", "vaillant-heat-measure-12-3.webp", "vaillant-heat-measure-13-4.webp", "vaillant-heat-measure-21-3.webp",
  "vaillant-heat-10-clean.webp", "vaillant-heat-14-clean.webp", "vaillant-heat-16-clean.webp", "vaillant-heat-17-clean.webp", "vaillant-heat-18-clean.webp", "vaillant-heat-19-clean.webp", "vaillant-heat-20-clean.webp",
]);
const isMeasurementImage = (file: string) => measurementImageFiles.has(file);
const images = import.meta.glob<{ default: ImageMetadata }>("../../../assets/spare-parts/optimized/*.webp", { eager: true });
const imageByFile = new Map(Object.entries(images).map(([path, image]) => {
  const file = path.split("/").at(-1)!;
  return [file, { ...image.default, src: `/img/spare-parts/${file}` }];
}));

export const getStaticPaths = (() => {
  const brand = sparePartsBrands.find((item) => item.slug === "vaillant")!;
  return brand.parts.filter((part) => part.slug).map((part) => ({ params: { slug: part.slug! }, props: { part } }));
}) satisfies GetStaticPaths;

const { part } = Astro.props as { part: SparePart };
const telegramRequestUrl = `/zapchasti/request/?start=request-vaillant-${sparePartsBrands.find((item) => item.slug === "vaillant")!.parts.indexOf(part).toString(36)}`;
const canonical = `https://remontkotlov48.ru/zapchasti/vaillant/${part.slug}/`;
const imageFile = imageFilesBySlug.get(part.slug ?? "");
const productImage = imageFile ? imageByFile.get(imageFile) : undefined;
if (!productImage) throw new Error(`Не найдено изображение товара ${part.slug}`);
const ogImage = new URL(productImage.src, "https://remontkotlov48.ru").href;
const galleryImages = [imageFile, ...(galleryImageFilesBySlug.get(part.slug ?? "") ?? [])]
  .map((file) => ({ file, image: file ? imageByFile.get(file) : undefined }))
  .filter((item): item is { file: string; image: ImageMetadata } => Boolean(item.image));
const compatibleModels = compatibleModelsBySlug.get(part.slug ?? "") ?? [];
const seo = buildProductSeo(part, "Vaillant", compatibleModels);
const title = buildProductTitle(part);
const seoModels = compatibleModels.slice(0, 3);
const compatibilitySeoText = seoModels.length ? ` Подходит для моделей: ${seoModels.join(", ")}.` : "";
const categorySlug = part.category === "Теплообменники" ? "teploobmenniki" : "ventilyatory";
const categoryUrl = `/zapchasti/vaillant/${categorySlug}/`;
const structuredData = { "@context": "https://schema.org", "@graph": [
  { "@type": "Product", name: part.name, description: seo.lead, sku: part.article, category: part.category, brand: { "@type": "Brand", name: "Vaillant" }, url: canonical, additionalProperty: compatibleModels.map((model) => ({ "@type": "PropertyValue", name: "Совместимая модель котла", value: model })) },
  { "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: "https://remontkotlov48.ru/" },
    { "@type": "ListItem", position: 2, name: "Запчасти", item: "https://remontkotlov48.ru/zapchasti/" },
    { "@type": "ListItem", position: 3, name: `Vaillant · ${part.category}`, item: `https://remontkotlov48.ru${categoryUrl}` },
    { "@type": "ListItem", position: 4, name: part.name, item: canonical },
  ] },
] };
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={seo.metaDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="product" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={`${part.name} — купить в Липецке | Gazmaster`} />
    <meta property="og:description" content={`${part.name} для котлов Vaillant. Артикул ${part.article}.${compatibilitySeoText}`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={part.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" href={canonical} hreflang="ru-RU" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <header><a class="brand" href="/"><b class="brand-logo"><img src="/img/gazmaster-watermark.webp" alt="" /></b><span><strong>Gazmaster</strong><small>Ремонт котлов · Липецк</small></span></a><nav><a href="/lipeck/uslugi/remont-gazovyh-kotlov/">Ремонт котлов</a><a href="/zapchasti/">Запчасти</a></nav><a class="call" href={phoneHref}>Вызвать мастера</a></header>
    <main>
      <nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/">Главная</a><span>/</span><a href="/zapchasti/">Запчасти</a><span>/</span><a href={categoryUrl}>Vaillant · {part.category}</a><span>/</span><b>{part.name}</b></nav>
      <article class="product"><div class="product-gallery" data-product-gallery><div class="product-image">{galleryImages.map((item, index) => <div class:list={["gallery-frame", { active: index === 0 }]} data-gallery-frame={index} hidden={index !== 0}><img src={item.image.src} width={item.image.width} height={item.image.height} alt={`${part.name}${isMeasurementImage(item.file) ? " — размеры по линейке" : index ? ` — ракурс ${index + 1}` : ""}`} loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} /></div>)}</div>{(galleryImages.length > 1 || galleryImages.some((item) => isMeasurementImage(item.file))) && <div class="gallery-thumbs" aria-label="Другие ракурсы товара">{galleryImages.map((item, index) => <button class:list={[{ active: index === 0 }, { measurement: isMeasurementImage(item.file) }]} type="button" data-gallery-thumb={index} aria-label={isMeasurementImage(item.file) ? "Показать размеры по линейке" : `Показать ракурс ${index + 1}`} aria-pressed={index === 0}><img src={item.image.src} width={item.image.width} height={item.image.height} alt={`${part.name}${isMeasurementImage(item.file) ? " — размеры по линейке" : index ? ` — ракурс ${index + 1}` : ""}`} loading="lazy" />{isMeasurementImage(item.file) && <span>Размеры</span>}</button>)}</div>}</div><div class="product-details"><p class="eyebrow">{part.category} Vaillant</p><h1>{part.name}</h1><p class="article">Артикул: <b>{part.article}</b></p><p class="lead">{seo.lead}</p><div class="availability"><b>Наличие и цена — по запросу</b><span>Срок поставки — до 7 дней после подтверждения артикула.</span><span>Гарантия — 12 месяцев при правильной эксплуатации котла.</span></div><a class="buy" href={telegramRequestUrl}>Уточнить наличие</a></div></article>
      <section class="details"><h2>Совместимые модели котлов</h2>{compatibleModels.length > 0 ? <><ul>{compatibleModels.map((model) => <li>{model}</li>)}</ul><p>Список приведён по данным производителя. Перед заказом сверим точную модель, серийный номер и комплектацию котла.</p></> : <p>Совместимость проверяем по артикулу старой детали, модели и серийному номеру котла.</p>}<h2>Особенности подбора</h2><p>{seo.details}</p><h2>Как заказать</h2><p>Позвоните нам или отправьте фото шильдика: подтвердим совместимость, цену и наличие; срок поставки — до 7 дней.</p></section>
      <p class="back"><a href={categoryUrl}>← Все {part.category.toLowerCase()} Vaillant</a></p>
    </main>
    <footer><div><strong>Gazmaster</strong><span>Ремонт, диагностика и подбор запчастей для котлов в Липецке.</span></div><a href={phoneHref}>{phone}</a></footer><script>document.querySelectorAll<HTMLElement>("[data-product-gallery]").forEach((gallery) => { const frames = gallery.querySelectorAll<HTMLElement>("[data-gallery-frame]"); const thumbs = gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]"); thumbs.forEach((thumb) => thumb.addEventListener("click", () => { const selected = thumb.dataset.galleryThumb; frames.forEach((frame) => { frame.hidden = frame.dataset.galleryFrame !== selected; frame.classList.toggle("active", frame.dataset.galleryFrame === selected); }); thumbs.forEach((item) => { const active = item === thumb; item.classList.toggle("active", active); item.setAttribute("aria-pressed", String(active)); }); })); });</script>
  </body>
</html>

