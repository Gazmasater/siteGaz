---
import ProthermCategoryPage from "../../../components/ProthermCategoryPage.astro";

const faq = [
  { question: "Как подобрать теплообменник Vaillant?", answer: "Сверьте артикул снятой детали, модель котла и его серийный номер. Количество пластин, габариты и подключения должны полностью совпадать." },
  { question: "Чем отличаются первичный и вторичный теплообменники?", answer: "Первичный теплообменник нагревает теплоноситель от горелки. Вторичный пластинчатый теплообменник передаёт тепло воде ГВС в двухконтурных котлах." },
  { question: "Можно ли выбрать теплообменник только по фотографии?", answer: "Фото помогает сориентироваться, но для заказа обязательно нужны артикул и точная модель котла. Мы проверим совместимость перед заказом." },
];
---

<ProthermCategoryPage category="Теплообменники" brandSlug="vaillant" brandName="Vaillant" title="Теплообменники для котлов Vaillant в Липецке" description="Первичные и вторичные теплообменники для газовых котлов Vaillant: turboTEC, turboMAX, atmoMAX и turboFIT. Подбор по модели и артикулу в Липецке." intro="Каталог теплообменников для газовых котлов Vaillant. Подберём первичный или вторичный теплообменник по артикулу, модели и серийному номеру: это исключает ошибку по габаритам, количеству пластин и подключениям." selectionTitle="Как подобрать теплообменник Vaillant" selectionText="Укажите модель котла, артикул старой детали или отправьте фото шильдика. Мы сверим совместимость, тип теплообменника и сообщим наличие." faq={faq} />
