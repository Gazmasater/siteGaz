---
import ProthermCategoryPage from "../../../components/ProthermCategoryPage.astro";

const faq = [
  { question: "Как подобрать вентилятор Vaillant?", answer: "Сверьте артикул снятой детали, точную модель котла и его серийный номер. Внешне похожие вентиляторы могут отличаться разъёмом, креплением и характеристиками." },
  { question: "Можно ли выбрать вентилятор только по фотографии?", answer: "Фотография помогает сориентироваться, но для заказа её недостаточно. Сообщите модель котла и артикул — мы проверим совместимость." },
  { question: "Для каких котлов есть вентиляторы?", answer: "В каталоге представлены позиции для Vaillant turboTEC, turboMAX, turboTEC plus и turboFIT. Актуальную совместимость уточняем перед заказом." },
];
---

<ProthermCategoryPage category="Вентиляторы" brandSlug="vaillant" brandName="Vaillant" title="Вентиляторы для котлов Vaillant в Липецке" description="Вентиляторы для газовых котлов Vaillant turboTEC, turboMAX, turboTEC plus и turboFIT. Подбор по модели и артикулу в Липецке." intro="Каталог вентиляторов для газовых котлов Vaillant. Подберём деталь по артикулу, модели и серийному номеру: это важно для совпадения разъёма, крепления и характеристик дымоудаления." selectionTitle="Как подобрать вентилятор Vaillant" selectionText="Укажите модель котла, артикул старого вентилятора или отправьте фото шильдика. Мы сверим совместимость до заказа и сообщим наличие." faq={faq} />
