---
import ProthermCategoryPage from "../../../components/ProthermCategoryPage.astro";

const faq = [
  { question: "Как подобрать вентилятор Ariston?", answer: "Сообщите модель котла, артикул старого вентилятора и серийный номер. Внешне похожие вентиляторы могут отличаться мощностью, креплением и разъёмом." },
  { question: "Для каких котлов есть вентиляторы?", answer: "В каталоге есть вентиляторы для серий Alteas X, Cares X, Clas X, Genus X, Clas, Egis, Matis и Uno. Совместимость проверяем перед заказом." },
  { question: "Можно заказать по артикулу?", answer: "Да. Укажите артикул и модель котла — уточним наличие, цену и срок поставки." },
];
---

<ProthermCategoryPage
  category="Вентиляторы"
  brandSlug="ariston"
  brandName="Ariston"
  title="Вентиляторы для котлов Ariston в Липецке"
  description="Вентиляторы для газовых котлов Ariston и Chaffoteaux. Подбор по модели, артикулу и серийному номеру в Липецке."
  intro="Каталог вентиляторов для газовых котлов Ariston. Подберём деталь по артикулу, модели и серийному номеру: это важно для совпадения мощности, разъёма и крепления."
  selectionTitle="Как подобрать вентилятор Ariston"
  selectionText="Укажите модель котла, артикул старого вентилятора или отправьте фото шильдика. Мы сверим совместимость до заказа и сообщим наличие."
  faq={faq}
/>
