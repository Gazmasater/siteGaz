---
import ProthermCategoryPage from "../../../components/ProthermCategoryPage.astro";

const faq = [
  { question: "Как подобрать теплообменник Ariston?", answer: "Сообщите модель котла, артикул детали и серийный номер. Для основных теплообменников важны версия, год выпуска и тип камеры сгорания." },
  { question: "Есть ли размеры теплообменников?", answer: "Если у поставщика есть фотография с измерением, она показана в галерее конкретной карточки отдельной миниатюрой «Размеры»." },
  { question: "Можно заказать по артикулу?", answer: "Да. Укажите артикул и модель котла — уточним совместимость, наличие, цену и срок поставки." },
];
---

<ProthermCategoryPage
  category="Теплообменники"
  brandSlug="ariston"
  brandName="Ariston"
  title="Теплообменники для котлов Ariston в Липецке"
  description="Основные, битермические и вторичные теплообменники для газовых котлов Ariston и Chaffoteaux. Подбор по модели, артикулу и серийному номеру в Липецке."
  intro="Каталог теплообменников для газовых котлов Ariston: основные, битермические, вторичные ГВС и варианты с трубками. Совместимость каждой позиции указана в карточке и проверяется перед заказом."
  selectionTitle="Как подобрать теплообменник Ariston"
  selectionText="Укажите модель, артикул старой детали, год выпуска и пришлите фото шильдика. Для основного теплообменника также сверяем версию котла и тип камеры сгорания."
  faq={faq}
/>
