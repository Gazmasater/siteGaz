export const getStaticPaths = (() => {
  const brand = sparePartsBrands.find((item) => item.slug === "ariston")!;
  return brand.parts.map((part) => ({ params: { slug: part.slug! }, props: { part } }));
}) satisfies GetStaticPaths;

const { part } = Astro.props as { part: SparePart };
const telegramRequestUrl = `/zapchasti/request/?start=request-ariston-${sparePartsBrands.find((item) => item.slug === "ariston")!.parts.indexOf(part).toString(36)}`;
const imageFile = imageFilesBySlug.get(part.slug ?? "");
if (!imageFile) throw new Error(`Не найдено изображение товара ${part.slug}`);
const measurementImageFile = measurementImageFilesBySlug.get(part.slug ?? "");
const compatibleModels = compatibleModelsBySlug.get(part.slug ?? "") ?? ["Подбор по артикулу, модели и серийному номеру котла"];
const seo = buildProductSeo(part, "Ariston", compatibleModels);
const title = buildProductTitle(part);
const canonical = `https://remontkotlov48.ru/zapchasti/ariston/${part.slug}/`;
const ogImage = `https://remontkotlov48.ru/img/spare-parts/${imageFile}`;
const categorySlug = part.category === "Теплообменники" ? "teploobmenniki" : "ventilyatory";
const categoryUrl = `/zapchasti/ariston/${categorySlug}/`;
const seoModels = compatibleModels.slice(0, 3);
const structuredData = { "@context": "https://schema.org", "@graph": [
  { "@type": "Product", name: part.name, description: seo.lead, sku: part.article, category: part.category, brand: { "@type": "Brand", name: "Ariston" }, url: canonical, additionalProperty: compatibleModels.map((model) => ({ "@type": "PropertyValue", name: "Совместимая модель котла", value: model })) },
  { "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: "https://remontkotlov48.ru/" },
    { "@type": "ListItem", position: 2, name: "Запчасти", item: "https://remontkotlov48.ru/zapchasti/" },
    { "@type": "ListItem", position: 3, name: `Ariston · ${part.category}`, item: `https://remontkotlov48.ru${categoryUrl}` },
    { "@type": "ListItem", position: 4, name: part.name, item: canonical },
  ] },
] };
