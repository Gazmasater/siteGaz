---
import ProthermCategoryPage from "../../../components/ProthermCategoryPage.astro";

const faq = [
  { question: "Как подобрать теплообменник Navien?", answer: "Сообщите модель котла, артикул детали и серийный номер. Для основного теплообменника важны версия, год выпуска и тип камеры сгорания." },
  { question: "Есть ли размеры теплообменников?", answer: "Если у поставщика есть фотография с измерением, она показана в галерее конкретной карточки отдельной миниатюрой «Размеры»." },
  { question: "Можно заказать по артикулу?", answer: "Да. Укажите артикул и модель котла — уточним совместимость, наличие, цену и срок поставки." },
];
---

<ProthermCategoryPage
  category="Теплообменники"
  brandSlug="navien"
  brandName="Navien"
  title="Теплообменники для котлов Navien в Липецке"
  description="Основные и вторичные теплообменники ГВС для газовых котлов Navien Ace, Deluxe, Prime, Smart Tok и NCB700. Подбор по модели, артикулу и серийному номеру в Липецке."
  intro="Каталог теплообменников для газовых котлов Navien: основные и вторичные ГВС. Совместимость каждой позиции указана в карточке и проверяется перед заказом."
  selectionTitle="Как подобрать теплообменник Navien"
  selectionText="Укажите модель, артикул старой детали, год выпуска и пришлите фото шильдика. Для основного теплообменника также сверяем версию котла и тип камеры сгорания."
  faq={faq}
/>
