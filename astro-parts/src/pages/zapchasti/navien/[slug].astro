---
import type { GetStaticPaths } from "astro";
import { sparePartsBrands, type SparePart } from "../../../../../app/data/spareParts";
import { buildProductSeo, buildProductTitle } from "../../../../../app/data/productSeo";

const phone = "8 (962) 352-70-02";
const phoneHref = "tel:+79623527002";
const imageFilesBySlug = new Map([
  ["ace-30-35-30005562c", "navien-fan-01.webp"], ["ace-40-30007950a", "navien-fan-02.webp"], ["deluxe-s-c-one-13-24-30021105a", "navien-fan-03.webp"], ["deluxe-s-c-one-35-40-30021106a", "navien-fan-04.webp"], ["deluxe-13-24-30012680a", "navien-fan-05.webp"], ["deluxe-30-40-30010860b", "navien-fan-06.webp"], ["ace-13-24-30005567a", "navien-fan-07.webp"],
  ["gvs-12-30004997", "navien-heat-01.webp"], ["gvs-condevo-30017721", "navien-heat-02.webp"], ["gvs-40-30005013", "navien-heat-03.webp"], ["gvs-30-30005005", "navien-heat-04.webp"], ["gvs-deluxe-c-30-35-30013798", "navien-heat-05.webp"], ["gvs-deluxe-s-35-30018296", "navien-heat-06.webp"], ["gvs-deluxe-s-coaxial-30017721", "navien-heat-07.webp"], ["gvs-ncb700-35-30018297", "navien-heat-08.webp"], ["gvs-ace-13-24-30004995", "navien-heat-09.webp"], ["gvs-ace-24-30004997", "navien-heat-10.webp"], ["gvs-35-30005008", "navien-heat-11.webp"], ["gvs-deluxe-13-20-30004993", "navien-heat-12-clean.webp"], ["main-atmo-13-16-30004896", "navien-heat-13.webp"], ["main-13-24-30012859", "navien-heat-14.webp"], ["main-atmo-20-24-30004894", "navien-heat-15.webp"], ["main-30-30012860", "navien-heat-16.webp"], ["main-35-40-30012723", "navien-heat-17-clean.webp"],
]);
const measurementImageFilesBySlug = new Map<string, string[]>([
  ["gvs-ace-13-24-30004995", ["navien-heat-measure-09.webp"]],
  ["main-atmo-13-16-30004896", ["navien-heat-measure-13.webp"]],
  ["main-13-24-30012859", ["navien-heat-measure-14.webp"]],
  ["main-atmo-20-24-30004894", ["navien-heat-measure-15.webp"]],
  ["main-30-30012860", ["navien-heat-measure-16.webp"]],
  ["main-35-40-30012723", ["navien-heat-measure-17-h.webp", "navien-heat-measure-17-v.webp"]],
]);
const series = (name: string, powers: string[]) => powers.map((power) => `Navien ${name} ${power}K`);
const classic1324 = [...series("Deluxe", ["13", "16", "20", "24"]), ...series("Deluxe Coaxial", ["13", "16", "20", "24"]), ...series("Deluxe Plus", ["13", "16", "20", "24"]), ...series("Deluxe Plus Coaxial", ["13", "16", "20", "24"]), ...series("Prime Coaxial", ["13", "16", "20", "24"]), ...series("Smart Tok Coaxial", ["13", "16", "20", "24"]), ...series("Ace", ["13", "16", "20", "24"]), ...series("Ace Coaxial", ["13", "16", "20", "24"]), "Navien Atmo 13A(N)", "Navien Atmo 16A(N)", "Navien Atmo 20A(N)", "Navien Atmo 24A(N)"];
const deluxeS1324 = series("Deluxe S Coaxial", ["13", "16", "20", "24"]);
const group30 = [...series("Ace", ["30"]), ...series("Ace Coaxial", ["30"]), ...series("Deluxe", ["30"]), ...series("Deluxe Coaxial", ["30"]), ...series("Deluxe Plus", ["30"]), ...series("Deluxe Plus Coaxial", ["30"]), ...series("Prime Coaxial", ["30"]), ...series("Smart Tok Coaxial", ["30"])];
const compatibleModelsBySlug = new Map<string, string[]>([
  ["ace-30-35-30005562c", ["Navien Ace 30K", "Navien Ace 35K", "Navien Ace Coaxial 13K", "Navien Ace Coaxial 16K", "Navien Ace Coaxial 20K", "Navien Ace Coaxial 24K", "Navien Ace Coaxial 30K"]],
  ["ace-40-30007950a", ["Navien Ace 40K"]],
  ["deluxe-s-c-one-13-24-30021105a", ["Navien Deluxe S 13K", "Navien Deluxe S 16K", "Navien Deluxe S 20K", "Navien Deluxe S 24K", "Navien Deluxe Comfort 13K", "Navien Deluxe Comfort 16K", "Navien Deluxe Comfort 20K", "Navien Deluxe Comfort 24K", "Navien Deluxe One 24K"]],
  ["deluxe-s-c-one-35-40-30021106a", ["Navien Deluxe S 35K", "Navien Deluxe S 40K", "Navien Deluxe C 35K", "Navien Deluxe C 40K", "Navien One 35K", "Navien One 40K", "Navien Deluxe C Plus 35K", "Navien Deluxe C Plus 40K"]],
  ["deluxe-13-24-30012680a", [...series("Deluxe", ["13", "16", "20", "24"]), ...series("Deluxe Coaxial", ["13", "16", "20", "24"]), ...series("Deluxe Plus", ["13", "16", "20", "24"]), ...series("Prime Coaxial", ["13", "16", "20", "24"]), ...series("Smart Tok", ["13", "16", "20", "24"])]],
  ["deluxe-30-40-30010860b", ["Navien Deluxe 30K", "Navien Deluxe 35K", "Navien Deluxe 40K", "Navien Deluxe Coaxial 30K", "Navien Deluxe Plus 30K", "Navien Deluxe Plus 35K", "Navien Deluxe Plus 40K", "Navien Prime Coaxial 30K", "Navien Prime Coaxial 35K", "Navien Smart Tok 30K", "Navien Smart Tok 35K"]],
  ["ace-13-24-30005567a", series("Ace", ["13", "16", "20", "24"])],
  ["gvs-12-30004997", classic1324],
  ["gvs-condevo-30017721", deluxeS1324],
  ["gvs-40-30005013", ["Navien Ace 40K", "Navien Deluxe 40K"]],
  ["gvs-30-30005005", ["Navien Deluxe 30K", "Navien Deluxe Coaxial 30K", "Navien Prime Coaxial 30K", "Navien Smart Tok Coaxial 30K", "Navien Deluxe Plus 30K", "Navien Deluxe Plus Coaxial 30K", "Navien Ace 30K", "Navien Ace Coaxial 30K"]],
  ["gvs-deluxe-c-30-35-30013798", ["Navien Deluxe C 30K", "Navien Deluxe C 35K"]],
  ["gvs-deluxe-s-35-30018296", ["Navien Deluxe S 35K"]],
  ["gvs-deluxe-s-coaxial-30017721", deluxeS1324],
  ["gvs-ncb700-35-30018297", ["Navien NCB700-35K"]],
  ["gvs-ace-13-24-30004995", [...series("Ace", ["13", "16", "20"]), ...series("Ace Coaxial", ["13", "16", "20"]), "Navien Atmo 13A(N)", "Navien Atmo 16A(N)", "Navien Deluxe 24K", "Navien Deluxe Coaxial 24K", "Navien Deluxe Plus 24K", "Navien Deluxe Plus Coaxial 24K", "Navien Prime Coaxial 24K", "Navien Smart Tok Coaxial 24K"]],
  ["gvs-ace-24-30004997", ["Navien Ace 24K", "Navien Ace Coaxial 24K", "Navien Atmo 20A(N)", "Navien Atmo 24A(N)"]],
  ["gvs-35-30005008", ["Navien Ace 35K", "Navien Deluxe 35K", "Navien Deluxe Plus 35K", "Navien Prime Coaxial 35K", "Navien Smart Tok Coaxial 35K"]],
  ["gvs-deluxe-13-20-30004993", [...series("Deluxe", ["13", "16", "20"]), ...series("Deluxe Coaxial", ["13", "16", "20"]), ...series("Deluxe Plus", ["13", "16", "20"]), ...series("Deluxe Plus Coaxial", ["13", "16", "20"]), ...series("Prime Coaxial", ["13", "16", "20"]), ...series("Smart Tok Coaxial", ["13", "16", "20"])]],
  ["main-atmo-13-16-30004896", ["Navien Ace Atmo 13A(N)", "Navien Ace Atmo 16A(N)"]],
  ["main-13-24-30012859", [...series("Ace", ["13", "16", "20", "24"]), ...series("Ace Coaxial", ["13", "16", "20", "24"]), ...series("Deluxe", ["13", "16", "20", "24"]), ...series("Deluxe Coaxial", ["13", "16", "20", "24"]), ...series("Deluxe Plus", ["13", "16", "20", "24"]), ...series("Deluxe Plus Coaxial", ["13", "16", "20", "24"]), ...series("Prime Coaxial", ["13", "16", "20", "24"]), ...series("Smart Tok Coaxial", ["13", "16", "20", "24"])]],
  ["main-atmo-20-24-30004894", ["Navien Ace Atmo 20A(N)", "Navien Ace Atmo 24A(N)"]],
  ["main-30-30012860", group30],
  ["main-35-40-30012723", ["Navien Ace 35K", "Navien Ace 40K", "Navien Deluxe 35K", "Navien Deluxe 40K", "Navien Deluxe Plus 35K", "Navien Deluxe Plus 40K", "Navien Prime Coaxial 35K", "Navien Smart Tok Coaxial 35K"]],
]);

export const getStaticPaths = (() => {
  const brand = sparePartsBrands.find((item) => item.slug === "navien")!;
  return brand.parts.map((part) => ({ params: { slug: part.slug! }, props: { part } }));
}) satisfies GetStaticPaths;

const { part } = Astro.props as { part: SparePart };
const telegramRequestUrl = `/zapchasti/request/?start=request-navien-${sparePartsBrands.find((item) => item.slug === "navien")!.parts.indexOf(part).toString(36)}`;
const imageFile = imageFilesBySlug.get(part.slug ?? "");
if (!imageFile) throw new Error(`Не найдено изображение товара ${part.slug}`);
const measurementImageFiles = measurementImageFilesBySlug.get(part.slug ?? "") ?? [];
const compatibleModels = compatibleModelsBySlug.get(part.slug ?? "") ?? ["Подбор по артикулу, модели и серийному номеру котла"];
const seo = buildProductSeo(part, "Navien", compatibleModels);
const title = buildProductTitle(part);
const canonical = `https://remontkotlov48.ru/zapchasti/navien/${part.slug}/`;
const ogImage = `https://remontkotlov48.ru/img/spare-parts/${imageFile}`;
const categorySlug = part.category === "Теплообменники" ? "teploobmenniki" : "ventilyatory";
const categoryUrl = `/zapchasti/navien/${categorySlug}/`;
const seoModels = compatibleModels.slice(0, 3);
const structuredData = { "@context": "https://schema.org", "@graph": [
  { "@type": "Product", name: part.name, description: seo.lead, sku: part.article, category: part.category, brand: { "@type": "Brand", name: "Navien" }, url: canonical, additionalProperty: compatibleModels.map((model) => ({ "@type": "PropertyValue", name: "Совместимая модель котла", value: model })) },
  { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Главная", item: "https://remontkotlov48.ru/" }, { "@type": "ListItem", position: 2, name: "Запчасти", item: "https://remontkotlov48.ru/zapchasti/" }, { "@type": "ListItem", position: 3, name: `Navien · ${part.category}`, item: `https://remontkotlov48.ru${categoryUrl}` }, { "@type": "ListItem", position: 4, name: part.name, item: canonical }] },
] };
---
<!doctype html><html lang="ru"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={seo.metaDescription} /><meta name="robots" content="index, follow, max-image-preview:large" /><meta property="og:type" content="product" /><meta property="og:locale" content="ru_RU" /><meta property="og:title" content={title} /><meta property="og:description" content={seo.metaDescription} /><meta property="og:url" content={canonical} /><meta property="og:image" content={ogImage} /><meta property="og:image:alt" content={part.name} /><link rel="canonical" href={canonical} /><link rel="alternate" href={canonical} hreflang="ru-RU" /><script type="application/ld+json" set:html={JSON.stringify(structuredData)} /><title>{title}</title></head>
<body><header><a class="brand" href="/"><b><img src="/img/gazmaster-watermark.webp" alt="" /></b><span><strong>Gazmaster</strong><small>Ремонт котлов · Липецк</small></span></a><nav><a href="/lipeck/uslugi/remont-gazovyh-kotlov/">Ремонт котлов</a><a href="/zapchasti/">Запчасти</a></nav><a class="call" href={phoneHref}>Вызвать мастера</a></header><main><nav class="breadcrumbs"><a href="/">Главная</a><span>/</span><a href="/zapchasti/">Запчасти</a><span>/</span><a href={categoryUrl}>Navien · {part.category}</a><span>/</span><b>{part.name}</b></nav><article class="product"><div class="gallery"><div class="photo"><img data-main-image src={`/img/spare-parts/${imageFile}`} alt={part.name} width="800" height="600" loading="eager" fetchpriority="high" /></div>{measurementImageFiles.length > 0 && <div class="thumbnails"><button class="thumbnail active" type="button" data-gallery-image={`/img/spare-parts/${imageFile}`} aria-label="Основной ракурс"><img src={`/img/spare-parts/${imageFile}`} alt="Основной ракурс" /></button>{measurementImageFiles.map((file, index) => <button class="thumbnail dimensions" type="button" data-gallery-image={`/img/spare-parts/${file}`} aria-label={`Размеры, ракурс ${index + 1}`}><img src={`/img/spare-parts/${file}`} alt={`${part.name} — размеры по линейке, ракурс ${index + 1}`} /><span>Размеры</span></button>)}</div>}</div><div class="details"><p class="eyebrow">Запчасти Navien · {part.category}</p><h1>{part.name}</h1><p class="article">Артикул: <b>{part.article}</b></p><p class="lead">{seo.lead}</p><div class="availability"><b>Наличие и цена — по запросу</b><span>Срок поставки — до 7 дней после подтверждения артикула.</span><span>Гарантия — 12 месяцев при правильной эксплуатации котла.</span></div><a class="buy" href={telegramRequestUrl}>Уточнить наличие</a></div></article><section class="info"><h2>Совместимые модели котлов</h2><ul>{compatibleModels.map((model) => <li>{model}</li>)}</ul><p>Перед заказом обязательно сверяем модель, серийный номер и комплектацию котла.</p><h2>Особенности подбора</h2><p>{seo.details}</p><h2>Как заказать</h2><p>Позвоните нам или отправьте фото шильдика: подтвердим совместимость, цену и наличие; срок поставки — до 7 дней.</p></section><p class="back"><a href={categoryUrl}>← Все {part.category.toLowerCase()} Navien</a></p></main><footer><div><strong>Gazmaster</strong><span>Ремонт, диагностика и подбор запчастей для котлов в Липецке.</span></div><a href={phoneHref}>{phone}</a></footer><script>document.querySelectorAll('.thumbnail[data-gallery-image]').forEach((thumb) => thumb.addEventListener('click', () => { const main = document.querySelector('[data-main-image]'); if (main instanceof HTMLImageElement) main.src = thumb.dataset.galleryImage ?? main.src; document.querySelectorAll('.thumbnail').forEach((item) => item.classList.toggle('active', item === thumb)); }));</script></body></html>
<style>:root{color:#172033;font-family:Arial,sans-serif;background:#f5f7fb}*{box-sizing:border-box}body{margin:0}header,main{width:min(1180px,calc(100% - 40px));margin:auto}header{display:flex;align-items:center;gap:25px;min-height:76px}.brand{display:flex;align-items:center;gap:10px;color:#172033;text-decoration:none}.brand>b{display:grid;place-items:center;width:52px;height:42px}.brand img{display:block;width:100%;height:100%;object-fit:contain}.brand strong,.brand small{display:block}.brand strong{font-size:16px}.brand small{margin-top:3px;color:#7c8796;font-size:10px}header nav{display:flex;gap:19px;margin-left:auto}header nav a{color:#5b687a;font-size:13px;font-weight:700;text-decoration:none}.call,.buy{padding:12px 15px;border-radius:9px;color:#fff;background:#1c2737;font-size:13px;font-weight:800;text-decoration:none}.breadcrumbs{display:flex;flex-wrap:wrap;gap:8px;margin:32px 0 30px;color:#8390a4;font-size:13px}.breadcrumbs a,.back a{color:#526780;text-decoration:none}.product{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.88fr);gap:54px;padding:26px;border:1px solid #e2e7ee;border-radius:20px;background:#fff;box-shadow:0 12px 30px rgba(30,41,59,.05)}.photo{position:relative;overflow:hidden;border-radius:14px;background:#fff;aspect-ratio:4/3}.photo::after{position:absolute;inset:0;pointer-events:none;background:url('/img/gazmaster-watermark.webp') 10px 10px/30% auto no-repeat;content:"";opacity:.12}.photo img{display:block;width:100%;height:100%;object-fit:cover}.eyebrow{margin:3px 0 11px;color:#b77710;font-size:11px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.details h1{margin:0 0 15px;font-size:clamp(32px,4vw,49px);letter-spacing:-.05em;line-height:1.07}.article{color:#66768a}.lead,.info p{color:#5e6d80;font-size:15px;line-height:1.7}.availability{display:flex;flex-direction:column;gap:5px;margin:20px 0 15px;padding:14px 16px;border-radius:12px;background:#fff7e2;color:#7e5a19}.availability b,.availability span{font-size:13px}.buy{display:block;text-align:center}.info{max-width:760px;margin:38px 0}.info h2{margin:25px 0 10px;font-size:24px}.info ul{display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0;list-style:none}.info li{padding:8px 10px;border:1px solid #e4cf9d;border-radius:8px;color:#705219;background:#fff8e8;font-size:13px;font-weight:700}.back{margin:31px 0}.back a{font-weight:700}footer{display:flex;justify-content:space-between;gap:24px;padding:35px max(20px,calc((100% - 1180px)/2));color:#d6dce4;background:#111827}footer strong,footer span{display:block}footer strong{margin-bottom:5px;color:#fff;font-size:18px}footer span{font-size:12px}footer>a{color:#f6ca58;font-size:17px;font-weight:800;text-decoration:none}.thumbnails{display:flex;gap:10px;margin-top:10px}.thumbnail{position:relative;display:block;overflow:hidden;width:94px;padding:0;border:2px solid transparent;border-radius:9px;background:#fff;aspect-ratio:4/3;cursor:pointer}.thumbnail.active{border-color:#b77710}.thumbnail::after{position:absolute;inset:0;pointer-events:none;background:url('/img/gazmaster-watermark.webp') 3px 3px/30% auto no-repeat;content:"";opacity:.16}.thumbnail img{display:block;width:100%;height:100%;object-fit:cover}.thumbnail span{position:absolute;z-index:2;right:3px;bottom:3px;padding:2px 4px;border-radius:3px;color:#fff;background:rgba(23,32,51,.76);font-size:10px;font-weight:800}@media(max-width:760px){header,main{width:min(100% - 32px,1180px)}header{min-height:68px}header nav{display:none}.call{margin-left:auto}.product{grid-template-columns:1fr;gap:25px;padding:15px}.breadcrumbs{margin:25px 0 22px}.details h1{font-size:34px}footer{align-items:flex-start;flex-direction:column}}</style>
