const imageFor = (slug?: string) => {
  const cleanImage = cleanImageByFile.get(imageFileFor(slug) ?? "");
  if (!cleanImage) throw new Error(`Не найдено чистое изображение для ${slug}`);
  return cleanImage;
};
const imageSrcFor = (slug?: string, image?: string) => {
  if (image?.startsWith("/img/spare-parts/")) return image;
  const file = imageFileFor(slug);
  if (!file) throw new Error(`Не найдено чистое изображение для ${slug}`);
  return file.startsWith("vaillant-") || file.startsWith("viessmann-") || file.startsWith("ariston-") || file.startsWith("navien-") ? `/img/spare-parts/${file}` : imageFor(slug).src;
};
const productUrl = (brandSlug: string, slug?: string) => slug ? `/zapchasti/${brandSlug}/${slug}/` : "/kontakty/";
const telegramRequestUrl = (brandSlug: string, partIndex: number) => `/zapchasti/request/?start=request-${brandSlug}-${partIndex.toString(36)}`;
const hasLocalImage = (slug?: string, image?: string) => Boolean(imageFileFor(slug) || image?.startsWith("/img/spare-parts/"));
const partsFor = (brand: typeof catalogBrands[number]) => brand.slug === "ferroli"
  ? [...brand.parts].sort((left, right) => (left.category === "Вентиляторы" ? -1 : 1) - (right.category === "Вентиляторы" ? -1 : 1))
  : brand.parts;
const categoriesFor = (brand: typeof catalogBrands[number]) => [...new Set(partsFor(brand).map((part) => part.category))];
