    <footer><div><strong>Gazmaster</strong><span>Ремонт, диагностика и обслуживание газовых котлов в Липецке и области.</span></div><a href={phoneHref}>{phone}</a></footer>

    <script>
      const buttons = document.querySelectorAll<HTMLButtonElement>("[data-brand-button]");
      const panels = document.querySelectorAll<HTMLElement>("[data-brand-panel]");
      const submenus = document.querySelectorAll<HTMLElement>("[data-brand-submenu]");
      const categoryButtons = document.querySelectorAll<HTMLButtonElement>("[data-category-button]");
      const showAll = (slug: string | undefined) => {
        if (!slug) return;
        const cards = document.querySelectorAll<HTMLElement>(`[data-brand-panel="${slug}"] [data-part-category]`);
        cards.forEach((card) => { card.hidden = false; });
        const count = document.querySelector<HTMLElement>(`[data-brand-count="${slug}"]`);
        if (count) count.textContent = `${cards.length} позиций`;
        categoryButtons.forEach((item) => item.setAttribute("aria-pressed", "false"));
      };
      const activateBrand = (slug: string, shouldExpand: boolean) => {
        const activeButton = Array.from(buttons).find((button) => button.dataset.brandButton === slug);
        if (!activeButton) return;
        buttons.forEach((item) => { const isActive = item === activeButton; item.classList.toggle("active", isActive); item.setAttribute("aria-pressed", String(isActive)); item.setAttribute("aria-expanded", String(isActive && shouldExpand)); });
        panels.forEach((panel) => { panel.hidden = panel.dataset.brandPanel !== slug; });
        submenus.forEach((submenu) => { submenu.hidden = submenu.dataset.brandSubmenu !== slug || !shouldExpand; });
        showAll(slug);
      };
      buttons.forEach((button) => button.addEventListener("click", () => {
        const slug = button.dataset.brandButton;
        if (!slug) return;
        const isCurrentBrand = button.classList.contains("active");
        const shouldExpand = !isCurrentBrand || button.getAttribute("aria-expanded") !== "true";
        activateBrand(slug, shouldExpand);
        const url = new URL(window.location.href);
        if (url.searchParams.get("brand") !== slug) {
          url.searchParams.set("brand", slug);
          window.history.pushState({}, "", `${url.pathname}${url.search}${url.hash}`);
        }
      }));
      categoryButtons.forEach((button) => button.addEventListener("click", () => {
        const slug = button.dataset.categoryBrand;
        const category = button.dataset.categoryButton;
        if (!slug || !category) return;
        const cards = document.querySelectorAll<HTMLElement>(`[data-brand-panel="${slug}"] [data-part-category]`);
        let visible = 0;
        cards.forEach((card) => { const matches = card.dataset.partCategory === category; card.hidden = !matches; if (matches) visible += 1; });
        const count = document.querySelector<HTMLElement>(`[data-brand-count="${slug}"]`);
        if (count) count.textContent = `${visible} позиций`;
        categoryButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      }));
      const requestedBrand = new URL(window.location.href).searchParams.get("brand");
      if (requestedBrand) activateBrand(requestedBrand, true);
      window.addEventListener("popstate", () => {
        const brand = new URL(window.location.href).searchParams.get("brand");
        const defaultBrand = buttons.item(0)?.dataset.brandButton;
        activateBrand(brand || defaultBrand || "", Boolean(brand));
      });
    </script>
  </body>
</html>

