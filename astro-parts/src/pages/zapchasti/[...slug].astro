              {brand.slug === "fondital" && <nav class="category-links" aria-label="Категории запчастей Fondital"><a href="/zapchasti/fondital/ventilyatory/">Вентиляторы Fondital <b>1 позиция</b></a><a href="/zapchasti/fondital/teploobmenniki/">Теплообменники Fondital <b>9 позиций</b></a></nav>}
              <div class="product-grid">
                {partsFor(brand).map((part, partIndex) => <article class:list={["product-card", { "without-photo": !hasLocalImage(part.slug, part.image) }]} data-part-category={part.category}>
                  <a class="product-link" href={productUrl(brand.slug, part.slug)} aria-label={`Открыть карточку: ${part.name}`}>
                    {hasLocalImage(part.slug, part.image) && <div class="product-photo"><img src={imageSrcFor(part.slug, part.image)} alt={part.name} loading={index === 0 && partIndex === 0 ? "eager" : "lazy"} fetchpriority={index === 0 && partIndex === 0 ? "high" : "auto"} /></div>}
                    <div class="product-info"><div class="product-meta"><span>{part.category}</span><b>Каталог</b></div><h3>{part.name}</h3><p>{part.description}</p><div class="product-bottom"><span>Арт. {part.article}</span></div></div>
                  </a>
                  <a class="product-cta" href={telegramRequestUrl(brand.slug, brand.parts.indexOf(part))}>Уточнить наличие <i>→</i></a>
                </article>)}
              </div>
              <div class="help"><b>?</b><div><h2>Не нашли нужную деталь?</h2><p>Пришлите фото шильдика или назовите модель котла — поможем подобрать запчасть и сообщим срок поставки.</p></div><a href={phoneHref}>Позвонить мастеру</a></div>
