---
import ProthermCategoryPage from "../../../components/ProthermCategoryPage.astro";

const faq = [
  { question: "Как подобрать теплообменник Protherm?", answer: "Нужны модель котла, серийный номер и, если есть, артикул снятой детали. Для первичных и вторичных теплообменников важно проверить поколение и исполнение котла." },
  { question: "Зачем на фото линейка?", answer: "Размерный ракурс помогает сравнить деталь с установленной в котле. Линейка — дополнительная проверка, но окончательный подбор выполняется по модели и артикулу." },
  { question: "Какие теплообменники представлены?", answer: "В каталоге есть первичные, вторичные и битермические теплообменники для Protherm Пантера, Гепард, Lynx, Ягуар, Рысь, Леопард, Тигр и Лев." },
];
---

<ProthermCategoryPage category="Теплообменники" title="Теплообменники для котлов Protherm в Липецке" description="Первичные, вторичные и битермические теплообменники для газовых котлов Protherm. Подбор по модели, артикулу и серийному номеру в Липецке." intro="Каталог теплообменников для котлов Protherm: первичные, вторичные и битермические. На карточках есть артикулы, совместимые модели и измерительные ракурсы — для точного сравнения детали." selectionTitle="Подбор теплообменника по модели котла" selectionText="Не выбирайте теплообменник только по внешнему виду. Назовите модель, год или серийный номер котла, а также артикул детали, если он читается на снятом теплообменнике." faq={faq} />
