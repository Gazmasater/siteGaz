const images = import.meta.glob<{ default: ImageMetadata }>("../../../assets/spare-parts/optimized/*.{webp,png}", { eager: true });
const imageByFile = new Map(Object.entries(images).map(([path, image]) => [path.split("/").at(-1)!, image.default]));

export const getStaticPaths = (() => {
  const protherm = sparePartsBrands.find((item) => item.slug === "protherm")!;
  return protherm.parts
    .filter((part) => part.slug)
    .map((part) => ({ params: { slug: part.slug! }, props: { part } }));
}) satisfies GetStaticPaths;

const { part } = Astro.props as { part: SparePart };
const requestPayload = `request-protherm-${brand.parts.indexOf(part).toString(36)}`;
const telegramRequestUrl = `/zapchasti/request/?start=${requestPayload}`;
const canonicalSlug = preferredProductSlug("Protherm", part.slug);
const isDuplicate = canonicalSlug !== part.slug;
const canonical = `https://remontkotlov48.ru/zapchasti/protherm/${canonicalSlug}/`;
const imageFile = imageFilesBySlug.get(part.slug ?? "");
const productImage = imageFile ? imageByFile.get(imageFile) : undefined;
if (!productImage) throw new Error(`Не найдено изображение товара ${part.slug}`);
const ogImage = new URL(productImage.src, "https://remontkotlov48.ru").href;
const galleryImages = [imageFile, ...(galleryImageFilesBySlug.get(part.slug ?? "") ?? [])]
  .map((file) => ({ file, image: file ? imageByFile.get(file) : undefined }))
  .filter((item): item is { file: string; image: ImageMetadata } => Boolean(item.image));
const compatibleModels = compatibleModelsBySlug.get(part.slug ?? "") ?? [];
const seo = buildProductSeo(part, "Protherm", compatibleModels);
const title = buildProductTitle(part);
const seoModels = compatibleModels.slice(0, 3);
const compatibilitySeoText = seoModels.length ? ` Подходит для моделей: ${seoModels.join(", ")}.` : "";
const categoryUrl = part.category === "Вентиляторы" ? "/zapchasti/protherm/ventilyatory/" : "/zapchasti/protherm/teploobmenniki/";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      name: part.name,
      description: seo.lead,
      sku: part.article,
      category: part.category,
      brand: { "@type": "Brand", name: "Protherm" },
      url: canonical,
      additionalProperty: compatibleModels.map((model) => ({ "@type": "PropertyValue", name: "Совместимая модель котла", value: model })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Главная", item: "https://remontkotlov48.ru/" },
        { "@type": "ListItem", position: 2, name: "Запчасти", item: "https://remontkotlov48.ru/zapchasti/" },
        { "@type": "ListItem", position: 3, name: `Protherm · ${part.category}`, item: `https://remontkotlov48.ru${categoryUrl}` },
        { "@type": "ListItem", position: 4, name: part.name, item: canonical },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={seo.metaDescription} />
    <meta name="robots" content={isDuplicate ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta property="og:type" content="product" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={`${part.name} — купить в Липецке | Gazmaster`} />
    <meta property="og:description" content={`${part.name} для котлов Protherm. Артикул ${part.article}.${compatibilitySeoText}`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={part.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" href={canonical} hreflang="ru-RU" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner"><a class="brand" href="/" aria-label="Gazmaster — главная"><b class="brand-logo"><img src="/img/gazmaster-watermark.webp" alt="" /></b><span><strong>Gazmaster</strong><small>Ремонт котлов · Липецк</small></span></a><nav aria-label="Основная навигация"><a href="/lipeck/uslugi/remont-gazovyh-kotlov/">Ремонт котлов</a><a href="/zapchasti/">Запчасти</a></nav><a class="header-phone" href={phoneHref}>{phone}</a></div>
    </header>
    <main>
      <div class="container">
        <nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/">Главная</a><span>/</span><a href="/zapchasti/">Запчасти</a><span>/</span><a href={categoryUrl}>Protherm · {part.category}</a><span>/</span><b>{part.name}</b></nav>
        <article class="product">
          <div class="product-gallery" data-product-gallery>
            <div class="product-image">
              {galleryImages.map((item, index) => <div class:list={["gallery-frame", { active: index === 0 }]} data-gallery-frame={index} hidden={index !== 0}><Picture src={item.image} alt={`${part.name}${index ? item.file.startsWith("measure-") ? " — размеры по линейке" : ` — ракурс ${index + 1}` : ""}`} formats={["avif", "webp"]} fallbackFormat="webp" widths={[520, 880, 1200]} sizes="(max-width: 760px) calc(100vw - 32px), 560px" loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} /></div>)}
            </div>
            {galleryImages.length > 1 && <div class="gallery-thumbs" aria-label="Другие ракурсы товара">{galleryImages.map((item, index) => <button class:list={[{ active: index === 0 }, { measurement: item.file.startsWith("measure-") }]} type="button" data-gallery-thumb={index} aria-label={item.file.startsWith("measure-") ? "Показать размеры по линейке" : `Показать ракурс ${index + 1}`} aria-pressed={index === 0}><Picture src={item.image} alt={`${part.name}${item.file.startsWith("measure-") ? " — размеры по линейке" : index ? ` — ракурс ${index + 1}` : ""}`} formats={["webp"]} fallbackFormat="webp" widths={[100, 160]} sizes="76px" loading="lazy" />{item.file.startsWith("measure-") && <span>Размеры</span>}</button>)}</div>}
          </div>
          <div class="product-details"><p class="eyebrow">Запчасти Protherm · {part.category}</p><h1>{part.name}</h1><p class="article-number">Артикул: <b>{part.article}</b></p><p class="lead">{seo.lead}</p><div class="availability"><b>Наличие и цена</b><span>Срок поставки — до 7 дней после подтверждения артикула.</span><span>Гарантия — 12 месяцев при правильной эксплуатации котла.</span></div><a class="buy-button" href={phoneHref}>Уточнить цену и наличие</a><p class="note">Для точного подбора сообщите модель котла и серийный номер оборудования.</p></div>
        </article>
        <section class="details"><h2>Совместимые модели котлов</h2>{compatibleModels.length ? <ul class="models-list">{compatibleModels.map((model) => <li>{model}</li>)}</ul> : <p>Совместимость уточняем по модели и серийному номеру котла.</p>}<p class="compatibility-note">Перед заказом обязательно сверяем совместимость детали с конкретной моделью и комплектацией котла.</p><h2>Особенности подбора</h2><p>{seo.details}</p><h2>Как заказать</h2><p>Позвоните нам или оставьте заявку: назовите артикул <b>{part.article}</b> либо отправьте фото шильдика. Подтвердим цену и наличие; срок поставки — до 7 дней.</p></section>
        <p class="back"><a href="/zapchasti/">← Вернуться к каталогу запчастей</a></p>
      </div>
    </main>
    <footer><div><strong>Gazmaster</strong><span>Ремонт, диагностика и обслуживание газовых котлов в Липецке и области.</span></div><a href={phoneHref}>{phone}</a></footer>
    <script>
      document.querySelectorAll<HTMLElement>("[data-product-gallery]").forEach((gallery) => {
        const frames = gallery.querySelectorAll<HTMLElement>("[data-gallery-frame]");
        const thumbs = gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]");
        thumbs.forEach((thumb) => thumb.addEventListener("click", () => {
          const selected = thumb.dataset.galleryThumb;
          frames.forEach((frame) => { frame.hidden = frame.dataset.galleryFrame !== selected; frame.classList.toggle("active", frame.dataset.galleryFrame === selected); });
          thumbs.forEach((item) => { const active = item === thumb; item.classList.toggle("active", active); item.setAttribute("aria-pressed", String(active)); });
        }));
      });
    </script>
  </body>
</html>

<script define:vars={{ requestLink: telegramRequestUrl }}>
  const orderButton = document.querySelector<HTMLAnchorElement>("a.buy-button");
  if (orderButton) {
    orderButton.href = requestLink;
    orderButton.textContent = "Выбрать мессенджер";
  }
