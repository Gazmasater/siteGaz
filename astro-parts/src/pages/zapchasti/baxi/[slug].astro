const isDuplicate = canonicalSlug !== part.slug;
const canonical = `https://remontkotlov48.ru/zapchasti/baxi/${canonicalSlug}/`;
const imageFile = imageFilesBySlug.get(part.slug ?? "") ?? (part.slug?.startsWith("baxi-heat-") ? `${part.slug}.webp` : undefined);
