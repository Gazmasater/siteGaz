  { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Главная", item: "https://remontkotlov48.ru/" }, { "@type": "ListItem", position: 2, name: "Запчасти", item: "https://remontkotlov48.ru/zapchasti/" }, { "@type": "ListItem", position: 3, name: `Baxi · ${part.category}`, item: `https://remontkotlov48.ru${categoryUrl}` }, { "@type": "ListItem", position: 4, name: part.name, item: canonical }] },
