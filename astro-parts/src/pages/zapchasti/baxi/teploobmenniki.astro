---
import ProthermCategoryPage from "../../../components/ProthermCategoryPage.astro";

const title = "Теплообменники для котлов Baxi";
const description = "Теплообменники для газовых котлов Baxi в Липецке: первичные, битермические и ГВС. Подбор по артикулу, модели и серийному номеру.";
---

<ProthermCategoryPage
  category="Теплообменники"
  brandSlug="baxi"
  brandName="Baxi"
  title={title}
  description={description}
  intro="В каталоге — первичные, битермические и пластинчатые теплообменники ГВС для популярных серий Baxi. Совместимость проверяем по модели котла, артикулу и серийному номеру."
  selectionTitle="Подбор теплообменника Baxi по модели котла"
  selectionText="Для точного подбора важны тип теплообменника, количество пластин или каналов, артикул и версия котла. Сообщите данные со шильдика — предложим совместимую деталь."
  faq={[
    { question: "Как подобрать теплообменник для Baxi?", answer: "Назовите модель котла, артикул детали или пришлите фото шильдика. Сверим тип теплообменника и совместимость до заказа." },
    { question: "Есть ли теплообменники ГВС для Baxi Eco Classic и Eco Nova?", answer: "Да, в каталоге представлены пластинчатые теплообменники ГВС на 12, 14 и 16 пластин для этих серий." },
    { question: "Можно ли заказать основной теплообменник по артикулу?", answer: "Да. Укажите артикул Baxi или маркировку старой детали — проверим наличие и срок поставки." },
  ]}
/>
