---
import ProthermCategoryPage from "../../../components/ProthermCategoryPage.astro";

const title = "Вентиляторы для котлов Baxi";
const description = "Вентиляторы для газовых котлов Baxi в Липецке: подбор по артикулу, модели и серийному номеру. 18 позиций в каталоге.";
---

<ProthermCategoryPage
  category="Вентиляторы"
  brandSlug="baxi"
  brandName="Baxi"
  title={title}
  description={description}
  intro="В каталоге — вентиляторы для популярных серий Baxi Eco, Luna, Nuvola, Duo-Tec и HT. Проверим совместимость по модели котла, артикулу и серийному номеру перед заказом."
  selectionTitle="Подбор вентилятора Baxi по модели котла"
  selectionText="Вентилятор должен совпадать не только по серии котла, но и по мощности, версии и артикулу. Сообщите данные со шильдика — подберём совместимую деталь."
  faq={[
    { question: "Как подобрать вентилятор для Baxi?", answer: "Назовите модель котла, артикул детали или пришлите фото шильдика. Сверим мощность, версию котла и совместимость до заказа." },
    { question: "Есть ли вентиляторы для Baxi Eco, Luna и Nuvola?", answer: "Да, в каталоге представлены позиции для Eco, Eco-3, Luna, Luna-3, Nuvola и других серий Baxi." },
    { question: "Можно ли заказать деталь по артикулу?", answer: "Да. Укажите артикул Baxi или маркировку с вентилятора — проверим наличие и срок поставки." },
  ]}
/>
