---
const canonical = "https://remontkotlov48.ru/zapchasti/";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Отправить заявку на запчасть | Gazmaster</title>
  </head>
  <body>
    <main>
      <a class="back" href="/zapchasti/">← Вернуться в каталог</a>
      <section>
        <p>Заявка на запчасть</p>
        <h1>Выберите мессенджер</h1>
        <span>В заявке уже будет указана выбранная деталь. Менеджер уточнит совместимость, наличие и цену.</span>
        <div class="buttons" data-messengers hidden>
          <a class="telegram" data-telegram>Telegram</a>
          <a class="max" data-max>Max</a>
        </div>
        <p class="error" data-error hidden>Не удалось определить запчасть. Вернитесь в каталог и откройте нужную карточку.</p>
      </section>
    </main>
    <script>
      const payload = new URL(window.location.href).searchParams.get("start");
      const isValidPayload = /^request-[a-z0-9-]+-[0-9a-z]+$/i.test(payload ?? "");
      const messengers = document.querySelector<HTMLElement>("[data-messengers]");
      const error = document.querySelector<HTMLElement>("[data-error]");
      const telegram = document.querySelector<HTMLAnchorElement>("[data-telegram]");
      const max = document.querySelector<HTMLAnchorElement>("[data-max]");
      if (!isValidPayload || !payload || !telegram || !max || !messengers || !error) {
        error?.removeAttribute("hidden");
      } else {
        telegram.href = `https://t.me/gazmasterzip48_bot?start=${encodeURIComponent(payload)}`;
        max.href = `https://max.ru/id482414631253_bot?start=${encodeURIComponent(payload)}`;
        messengers.removeAttribute("hidden");
      }
    </script>
  </body>
</html>

<style>
  :root{color:#172033;font-family:Arial,sans-serif;background:#f5f7fb}*{box-sizing:border-box}body{margin:0}main{display:grid;min-height:100vh;place-content:center;width:min(100% - 32px,560px);margin:auto}.back{margin-bottom:22px;color:#526780;font-size:14px;font-weight:700;text-decoration:none}section{padding:34px;border:1px solid #e2e7ee;border-radius:20px;background:#fff;box-shadow:0 12px 30px rgba(30,41,59,.05)}section>p:first-child{margin:0 0 8px;color:#b77710;font-size:11px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}h1{margin:0 0 12px;font-size:clamp(30px,7vw,42px);letter-spacing:-.05em}section>span{display:block;color:#5e6d80;font-size:15px;line-height:1.6}.buttons{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:24px}.buttons a{padding:14px;border-radius:10px;color:#fff;font-size:15px;font-weight:800;text-align:center;text-decoration:none}.telegram{background:#229ed9}.max{background:#4f46e5}.error{margin:24px 0 0;color:#9b2c2c;font-size:14px;line-height:1.5}@media(max-width:440px){section{padding:24px}.buttons{grid-template-columns:1fr}}
</style>
