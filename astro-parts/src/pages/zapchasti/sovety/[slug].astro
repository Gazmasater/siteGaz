---
import type { GetStaticPaths } from "astro";
import { catalogGuides, type CatalogGuide } from "../../../../../app/data/catalogGuides";

const phone = "8 (962) 352-70-02";
const phoneHref = "tel:+79623527002";
export const getStaticPaths = (() => catalogGuides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }))) satisfies GetStaticPaths;
const { guide } = Astro.props as { guide: CatalogGuide };
const canonical = `https://remontkotlov48.ru/zapchasti/sovety/${guide.slug}/`;
const ogImage = "https://remontkotlov48.ru/img/header-boiler-generated-79330917276.webp";
const structuredData = { "@context": "https://schema.org", "@graph": [
  { "@type": "Article", headline: guide.title, description: guide.description, inLanguage: "ru-RU", mainEntityOfPage: canonical, author: { "@type": "Organization", name: "Gazmaster" }, publisher: { "@type": "Organization", name: "Gazmaster" } },
  { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Главная", item: "https://remontkotlov48.ru/" }, { "@type": "ListItem", position: 2, name: "Запчасти", item: "https://remontkotlov48.ru/zapchasti/" }, { "@type": "ListItem", position: 3, name: "Советы по подбору", item: "https://remontkotlov48.ru/zapchasti/sovety/" }, { "@type": "ListItem", position: 4, name: guide.title, item: canonical }] },
] };
---
<!doctype html>
<html lang="ru"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={guide.description} /><meta name="robots" content="index, follow, max-image-preview:large" /><meta property="og:type" content="article" /><meta property="og:locale" content="ru_RU" /><meta property="og:title" content={`${guide.title} | Gazmaster Липецк`} /><meta property="og:description" content={guide.description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={ogImage} /><meta property="og:image:width" content="1600" /><meta property="og:image:height" content="604" /><meta property="og:image:alt" content={guide.title} /><link rel="canonical" href={canonical} /><script type="application/ld+json" set:html={JSON.stringify(structuredData)} /><title>{guide.title} | Gazmaster Липецк</title></head>
<body><header><a class="brand" href="/"><img src="/img/gazmaster-watermark.webp" alt="" /><span><strong>Gazmaster</strong><small>Ремонт котлов · Липецк</small></span></a><nav><a href="/lipeck/uslugi/remont-gazovyh-kotlov/">Ремонт котлов</a><a href="/zapchasti/">Запчасти</a></nav><a class="call" href={phoneHref}>Подобрать запчасть</a></header><main><nav class="crumb"><a href="/">Главная</a><span>/</span><a href="/zapchasti/">Запчасти</a><span>/</span><a href="/zapchasti/sovety/">Советы</a><span>/</span><b>{guide.title}</b></nav><article><p class="eyebrow">Подбор запчастей для котлов</p><h1>{guide.title}</h1><p class="intro">{guide.intro}</p>{guide.sections.map((section) => <section><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}<section class="links"><h2>Полезные карточки каталога</h2><ul>{guide.links.map((link) => <li><a href={link.href}>{link.label} →</a></li>)}</ul></section><aside><b>Нужен точный подбор?</b><span>Пришлите фото шильдика и старой детали. Сверим артикул, модель и комплектацию перед заказом.</span><a href={phoneHref}>Позвонить: {phone}</a></aside></article><p class="back"><a href="/zapchasti/sovety/">← Все советы по подбору</a></p></main><footer><div><strong>Gazmaster</strong><span>Ремонт, диагностика и подбор запчастей для котлов в Липецке.</span></div><a href={phoneHref}>{phone}</a></footer></body></html>
<style>:root{font-family:Arial,sans-serif;color:#172033;background:#f5f7fb}*{box-sizing:border-box}body{margin:0}header,main{width:min(100% - 40px,980px);margin:auto}header{display:flex;align-items:center;min-height:76px;gap:22px}.brand{display:flex;align-items:center;gap:10px;color:#172033;text-decoration:none}.brand img{width:46px;height:42px;object-fit:contain}.brand strong,.brand small{display:block}.brand small{margin-top:3px;color:#7b8796;font-size:10px}header nav{display:flex;gap:18px;margin-left:auto}header nav a,.crumb a,.back a{color:#526780;font-size:13px;font-weight:700;text-decoration:none}.call{padding:11px 14px;border-radius:9px;color:#fff;background:#1c2737;font-size:13px;font-weight:800;text-decoration:none}.crumb{display:flex;flex-wrap:wrap;gap:8px;margin:30px 0;color:#8390a4;font-size:13px}article{padding:36px;border:1px solid #e2e7ee;border-radius:20px;background:#fff}.eyebrow{margin:0 0 12px;color:#b77710;font-size:11px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}h1{max-width:850px;margin:0;font-size:clamp(32px,5vw,52px);letter-spacing:-.045em;line-height:1.08}.intro{max-width:760px;margin:22px 0 34px;color:#53647a;font-size:18px;line-height:1.65}section{margin:28px 0}h2{margin:0 0 10px;font-size:24px}p{max-width:790px;color:#52627a;line-height:1.7}.links{padding:23px;border-radius:14px;background:#fff7e2}.links ul{margin:0;padding-left:20px}.links li+li{margin-top:9px}.links a{color:#704d09;font-weight:800;text-decoration:none}aside{display:flex;flex-direction:column;gap:8px;padding:22px;border-left:4px solid #b77710;border-radius:8px;background:#f4f7fa}aside span{color:#53647a;line-height:1.55}aside a{color:#172033;font-weight:800}.back{margin:28px 0}footer{display:flex;justify-content:space-between;gap:20px;padding:35px max(20px,calc((100% - 980px)/2));color:#d6dce4;background:#111827}footer strong,footer span{display:block}footer strong{margin-bottom:5px;color:#fff;font-size:18px}footer span{font-size:12px}footer>a{color:#f6ca58;font-weight:800;text-decoration:none}@media(max-width:700px){header,main{width:min(100% - 32px,980px)}header nav{display:none}.call{margin-left:auto}article{padding:22px}footer{align-items:flex-start;flex-direction:column}}</style>
